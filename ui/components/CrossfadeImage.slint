export component CrossfadeImage inherits Rectangle {
    in property <image> source;
    in property <duration> fade: 300ms;

    out property <bool> has-cover: (show-front ? front : back).width > 0;

    property <image> front;
    property <image> back;
    property <bool> show-front: true;

    function commit(img: image) {
        if show-front {
            back = img;
            show-front = false;
        } else {
            front = img;
            show-front = true;
        }
    }

    init => { if source.width > 0 { commit(source); } }
    changed source => { commit(source); }

    clip: true;
    border-radius: 12px;
    background: #0a1018;

    Image {
        source: front;
        width: 100%; height: 100%;
        image-fit: cover;
        opacity: show-front ? 1 : 0;
        animate opacity { duration: root.fade; easing: ease-in-out; }
    }
    Image {
        source: back;
        width: 100%; height: 100%;
        image-fit: cover;
        opacity: show-front ? 0 : 1;
        animate opacity { duration: root.fade; easing: ease-in-out; }
    }
    if !root.has-cover: Text {
        text: "♫";
        color: #ffffff10;
        font-size: 80px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}
