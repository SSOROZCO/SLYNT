import { VerticalBox, HorizontalBox } from "std-widgets.slint";
import { AudioTheme } from "../theme/Theme.slint";
import { PlayerState } from "../state/PlayerState.slint";

export component TransportBar inherits Rectangle {
    in-out property <bool> is-playing <=> PlayerState.is-playing;
    in-out property <float> progress <=> PlayerState.progress;
    in-out property <string> time-pos <=> PlayerState.time-pos;
    in-out property <string> time-total <=> PlayerState.time-total;
    in-out property <[float]> spectrum <=> PlayerState.spectrum;
    in-out property <string> repeat-mode <=> PlayerState.repeat-mode;
    in-out property <bool> shuffle <=> PlayerState.shuffle;

    callback play-pause();
    callback next();
    callback prev();
    callback seek(float);
    callback set-volume(float);
    callback toggle-shuffle();
    callback toggle-repeat();

    // ============================================================
    // TAMAÑO DEL TRANSPORT BAR
    // ============================================================
    min-height: 82px;

    border-radius: AudioTheme.radius-default;
    background: AudioTheme.glass;
    border-width: 1px;
    border-color: AudioTheme.glass-border;
    drop-shadow-blur: 24px;
    drop-shadow-color: #00000088;
    drop-shadow-offset-y: 12px;
    clip: true;

    // ============================================================
    // CONTENIDO PRINCIPAL
    // ============================================================
    VerticalLayout {
        spacing: 4px;

        padding-top: 8px;
        padding-bottom: 18px;
        padding-left: 18px;
        padding-right: 18px;

        // ========================================================
        // FILA SUPERIOR: Botones + Tiempo + Espectro
        // ========================================================
        HorizontalLayout {
            spacing: 14px;
            alignment: center;

            // ----------------------------------------------------
            // Botón Anterior
            // ----------------------------------------------------
            Rectangle {
                width: 44px;
                height: 44px;
                clip: false;

                Rectangle {
                    width: prev-area.has-hover ? 56px : 22px;
                    height: self.width;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;

                    border-radius: self.width / 2;
                    background: white;
                    opacity: prev-area.has-hover ? 1 : 0;

                    drop-shadow-blur: 8px;
                    drop-shadow-color: #00000033;

                    animate width {
                        duration: 400ms;
                        easing: cubic-bezier(0.35, 0.57, 0.13, 0.88);
                    }

                    animate opacity {
                        duration: 250ms;
                    }
                }

                Image {
                    source: @image-url("../icons/media-skip-backward.png");
                    width: 22px;
                    height: 22px;

                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;

                    image-fit: ImageFit.contain;
                    colorize: prev-area.has-hover
                        ? #00ff41
                        : AudioTheme.text;
                }

                prev-area := TouchArea {
                    clicked => {
                        root.prev();
                    }

                    mouse-cursor: pointer;
                }
            }

            // ----------------------------------------------------
            // Botón Play / Pause
            // ----------------------------------------------------
            Rectangle {
                width: 48px;
                height: 48px;
                clip: false;

                Rectangle {
                    width: play-area.has-hover ? 58px : 48px;
                    height: self.width;

                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;

                    border-radius: self.width / 2;
                    background: transparent;

                    border-width: 3px;
                    border-color: white;

                    drop-shadow-blur: 8px;
                    drop-shadow-color: #00000055;
                    drop-shadow-offset-y: 3px;

                    opacity: 0.9;

                    animate width {
                        duration: 400ms;
                        easing: cubic-bezier(0.35, 0.57, 0.13, 0.88);
                    }
                }

                Image {
                    source: is-playing
                        ? @image-url("../icons/media-playback-pause.png")
                        : @image-url("../icons/media-playback-start.png");

                    width: 22px;
                    height: 22px;

                    x: (parent.width - self.width) / 2
                        + (is-playing ? 0px : 1px);

                    y: (parent.height - self.height) / 2;

                    image-fit: ImageFit.contain;
                    colorize: white;
                }

                play-area := TouchArea {
                    clicked => {
                        root.play-pause();
                    }

                    mouse-cursor: pointer;
                }
            }

            // ----------------------------------------------------
            // Botón Siguiente
            // ----------------------------------------------------
            Rectangle {
                width: 44px;
                height: 44px;
                clip: false;

                Rectangle {
                    width: next-area.has-hover ? 56px : 22px;
                    height: self.width;

                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;

                    border-radius: self.width / 2;
                    background: white;
                    opacity: next-area.has-hover ? 1 : 0;

                    drop-shadow-blur: 8px;
                    drop-shadow-color: #00000033;

                    animate width {
                        duration: 400ms;
                        easing: cubic-bezier(0.35, 0.57, 0.13, 0.88);
                    }

                    animate opacity {
                        duration: 250ms;
                    }
                }

                Image {
                    source: @image-url("../icons/media-skip-forward.png");

                    width: 22px;
                    height: 22px;

                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;

                    image-fit: ImageFit.contain;

                    colorize: next-area.has-hover
                        ? #00ff41
                        : AudioTheme.text;
                }

                next-area := TouchArea {
                    clicked => {
                        root.next();
                    }

                    mouse-cursor: pointer;
                }
            }

            // ----------------------------------------------------
            // Separador
            // ----------------------------------------------------
            Rectangle {
                width: 1px;
                height: 20px;
                background: AudioTheme.border;
            }

            // ----------------------------------------------------
            // Shuffle
            // ----------------------------------------------------
            Rectangle {
                width: 36px;
                height: 36px;

                border-radius: 18px;

                background: shuffle
                    ? AudioTheme.accent-bg
                    : (sh-area.has-hover
                        ? AudioTheme.glass-hover
                        : transparent);

                border-width: shuffle ? 1px : 0px;

                border-color: shuffle
                    ? AudioTheme.accent-border
                    : transparent;

                animate background {
                    duration: AudioTheme.normal;
                }

                Image {
                    source: @image-url(
                        "../icons/media-playlist-shuffle.png"
                    );

                    width: 20px;
                    height: 20px;

                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;

                    image-fit: ImageFit.contain;

                    colorize: shuffle
                        ? AudioTheme.accent
                        : AudioTheme.text-faint;

                    animate colorize {
                        duration: AudioTheme.normal;
                    }
                }

                Rectangle {
                    width: shuffle ? 5px : 0px;
                    height: shuffle ? 2.5px : 0px;

                    border-radius: 2px;

                    background: AudioTheme.accent;

                    x: (parent.width - self.width) / 2;
                    y: parent.height - 4px;

                    animate width {
                        duration: AudioTheme.normal;
                    }
                }

                sh-area := TouchArea {
                    clicked => {
                        root.toggle-shuffle();
                    }
                }
            }

            // ----------------------------------------------------
            // Repeat
            // ----------------------------------------------------
            Rectangle {
                width: 36px;
                height: 36px;

                border-radius: 18px;

                background: repeat-mode != "Off"
                    ? AudioTheme.accent-bg
                    : (rep-area.has-hover
                        ? AudioTheme.glass-hover
                        : transparent);

                border-width: repeat-mode != "Off"
                    ? 1px
                    : 0px;

                border-color: repeat-mode != "Off"
                    ? AudioTheme.accent-border
                    : transparent;

                animate background {
                    duration: AudioTheme.normal;
                }

                Image {
                    source: @image-url(
                        "../icons/media-playlist-repeat.png"
                    );

                    width: 20px;
                    height: 20px;

                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;

                    image-fit: ImageFit.contain;

                    colorize: repeat-mode != "Off"
                        ? AudioTheme.accent
                        : AudioTheme.text-faint;

                    animate colorize {
                        duration: AudioTheme.normal;
                    }
                }

                // Indicador Repeat One
                Rectangle {
                    width: repeat-mode == "One" ? 12px : 0px;
                    height: repeat-mode == "One" ? 12px : 0px;

                    border-radius: 6px;

                    background: AudioTheme.accent;

                    x: parent.width - 5px;
                    y: -3px;

                    animate width {
                        duration: AudioTheme.normal;
                    }

                    Text {
                        text: "1";

                        color: #ffffff;
                        font-size: 7px;
                        font-weight: 700;

                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2
                            - 0.5px;

                        opacity: repeat-mode == "One" ? 1 : 0;
                    }
                }

                // Indicador Repeat All
                Rectangle {
                    width: repeat-mode == "All" ? 5px : 0px;
                    height: repeat-mode == "All" ? 2.5px : 0px;

                    border-radius: 2px;

                    background: AudioTheme.accent;

                    x: (parent.width - self.width) / 2;
                    y: parent.height - 4px;
                }

                rep-area := TouchArea {
                    clicked => {
                        root.toggle-repeat();
                    }
                }
            }

            // ----------------------------------------------------
            // Tiempo
            // ----------------------------------------------------
            Text {
                text: time-pos + " / " + time-total;

                color: AudioTheme.text-muted;
                font-size: AudioTheme.font-small;
            }

            // ----------------------------------------------------
            // Separador
            // ----------------------------------------------------
            Rectangle {
                width: 1px;
                height: 20px;

                background: AudioTheme.border;
            }

            // ====================================================
            // ESPECTRO
            // ====================================================
            Rectangle {
                horizontal-stretch: 1;

                height: 36px;
                clip: true;

                background: transparent;

                HorizontalLayout {
                    width: 100%;
                    height: 100%;

                    spacing: 2px;
                    padding-left: 4px;

                    alignment: end;

                    for bar[i] in spectrum: Rectangle {
                        width: 2px;
                        height: 100%;

                        Rectangle {
                            width: 100%;

                            height: is-playing
                                ? Math.max(
                                    parent.height * 0.85 * bar + 2px,
                                    2px
                                )
                                : 2px;

                            y: parent.height - self.height;

                            background: #00ff41;

                            opacity: is-playing
                                ? (0.14 + bar * 0.86)
                                : 0.05;

                            border-radius: 1px;

                            animate height {
                                duration: 70ms;
                                easing: ease-out;
                            }
                        }
                    }
                }
            }
        }
    }

    // ============================================================
    // BARRA DE PROGRESO
    //
    // IMPORTANTE:
    // Está FUERA del VerticalLayout.
    // Se fija directamente al borde inferior del TransportBar.
    // ============================================================
    Rectangle {
        x: 4px;
        y: parent.height - 16px;

        width: parent.width - 8px;
        height: 16px;

        background: transparent;

        // --------------------------------------------------------
        // Fondo de la barra
        // --------------------------------------------------------
        Rectangle {
            x: 0px;
            y: 7px;

            width: parent.width;
            height: 2px;

            border-radius: 2px;

            background: prog-area.has-hover
                ? AudioTheme.border-strong
                : AudioTheme.border;

            animate background {
                duration: 150ms;
            }
        }

        // --------------------------------------------------------
        // Progreso
        // --------------------------------------------------------
        Rectangle {
            x: 0px;

            y: prog-area.has-hover
                ? 6px
                : 7px;

            width: parent.width * progress;

            height: prog-area.has-hover
                ? 4px
                : 2px;

            border-radius: 2px;

            background: AudioTheme.text;

            drop-shadow-blur: prog-area.has-hover
                ? 8px
                : 0px;

            drop-shadow-color: AudioTheme.text;

            animate width {
                duration: 100ms;
            }
        }

        // --------------------------------------------------------
        // Punto de arrastre
        // --------------------------------------------------------
        Rectangle {
            width: prog-area.pressed
                ? 12px
                : 14px;

            height: prog-area.pressed
                ? 12px
                : 14px;

            border-radius: 7px;

            background: AudioTheme.text;

            x: parent.width * progress - 7px;
            y: 1px;

            drop-shadow-blur: 8px;
            drop-shadow-color: #00000044;

            opacity: prog-area.has-hover
                || prog-area.pressed
                ? 1
                : 0;

            animate opacity {
                duration: 150ms;
            }
        }

        // --------------------------------------------------------
        // Área táctil
        // --------------------------------------------------------
        prog-area := TouchArea {
            x: 0px;
            y: 0px;

            width: parent.width;
            height: parent.height;

            mouse-cursor: pointer;

            clicked => {
                root.seek(
                    self.mouse-x / self.width
                );
            }

            moved => {
                if (self.pressed) {
                    root.seek(
                        self.mouse-x / self.width
                    );
                }
            }
        }
    }
}

